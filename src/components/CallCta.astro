---
/**
 * Call-first contact CTA.
 *
 * Stands in for the contact and question forms while form delivery is out:
 * there is no Resend key and no verified sending domain, so every submission
 * would fail silently. Rather than leave a form that eats leads, calling is
 * made the obvious action. Restore the forms when EZLynx intake lands
 * (~2026-09-15) — see the commented import in the page that renders this.
 *
 * The tel: link needs no tracking code of its own: BaseLayout carries one
 * delegated phone_click listener for every `a[href^="tel:"]` on the site, and
 * it reads link_location from the nearest ancestor with an id — hence the
 * `id` on the wrapper here.
 */
import { BRAND } from '../consts';

interface Props {
  /** Sets GA4 phone_click link_location. Give each page its own. */
  id: string;
  eyebrow?: string;
  heading?: string;
  body?: string;
}

const {
  id,
  eyebrow = 'Talk to an advisor',
  heading = 'Give us a call',
  body = "You'll reach a real advisor — no phone tree, no call centre. Tell us what you've got and we'll tell you where you stand.",
} = Astro.props;
---

<div id={id} class="rounded-2xl border border-green-200 bg-green-50 px-6 py-8 sm:px-8 sm:py-10">
  <p class="text-green-700 text-xs font-semibold uppercase tracking-widest mb-2">{eyebrow}</p>
  <h2 class="text-2xl md:text-3xl font-display font-bold text-navy-900 mb-3">{heading}</h2>
  <p class="text-gray-600 leading-relaxed mb-7 max-w-prose">{body}</p>

  <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3">
    <a
      href={`tel:${BRAND.phoneE164}`}
      class="inline-flex items-center justify-center gap-2.5 px-7 py-4 bg-navy-900 hover:bg-navy-800 text-white font-semibold text-lg rounded-lg transition-colors"
    >
      <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      {BRAND.phone}
    </a>

    <a
      href={`sms:${BRAND.phoneE164}`}
      class="inline-flex items-center justify-center gap-2.5 px-7 py-4 border-2 border-navy-900 text-navy-900 hover:bg-navy-900 hover:text-white font-semibold text-lg rounded-lg transition-colors"
    >
      <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
      Text us
    </a>
  </div>

  <p class="mt-6 text-sm text-gray-600">
    <span class="font-semibold text-navy-900">{BRAND.hours}</span>
    <span class="block mt-1">
      Outside those hours, leave a message or email
      <a href={`mailto:${BRAND.email}`} class="font-medium text-green-700 underline hover:text-green-800 transition-colors">{BRAND.email}</a>
      — we answer every one.
    </span>
  </p>
</div>
