---
import { BRAND } from '../consts';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  {
    label: 'Services',
    href: '/services',
    children: [
      { label: 'Home & Auto', href: '/services/home-auto' },
      { label: 'Small Business', href: '/services/small-business' },
      { label: 'Life Insurance', href: '/services/life-insurance' },
      { label: 'Retirement Income', href: '/services/retirement-income' },
      { label: 'Long-Term Care', href: '/services/long-term-care' },
      { label: 'Medicare', href: '/services/medicare' },
    ],
  },
  { label: 'Our Process', href: '/process' },
  { label: 'Ask the Advisors', href: '/ask' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-navy-900 text-white sticky top-0 z-50 shadow-lg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">

      <!-- Logo / Brand -->
      <a href="/" class="flex items-center" aria-label={`${BRAND.name} — Home`}>
        <!-- PLACEHOLDER typographic wordmark. Swap for the Hearthside lockup
             once the logo is designed. The previous vector lockup is retired. -->
        <span class="font-serif font-semibold text-white text-xl md:text-2xl tracking-tight">
          {BRAND.name}
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        {navLinks.map((link) => (
          link.children ? (
            <div class="relative group">
              <button
                class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-navy-100 hover:text-white hover:bg-navy-800 rounded transition-colors"
                aria-expanded="false"
                aria-haspopup="true"
              >
                {link.label}
                <svg class="w-4 h-4 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute top-full left-0 mt-1 w-52 bg-white rounded-lg shadow-xl border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                {link.children.map((child) => (
                  <a
                    href={child.href}
                    class="block px-4 py-3 text-sm text-gray-700 hover:bg-navy-50 hover:text-navy-900 first:rounded-t-lg last:rounded-b-lg transition-colors"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class={`px-3 py-2 text-sm font-medium rounded transition-colors ${
                currentPath === link.href
                  ? 'text-gold-400 bg-navy-800'
                  : 'text-navy-100 hover:text-white hover:bg-navy-800'
              }`}
            >
              {link.label}
            </a>
          )
        ))}
      </nav>

      <!-- Tap-to-call + CTA + Mobile Toggle -->
      <div class="flex items-center gap-3">
        <!-- Always visible, including mobile — never collapses into the hamburger -->
        <a
          href={`tel:${BRAND.phoneE164}`}
          class="inline-flex items-center gap-2 px-3 py-2 border border-gold-500 text-gold-400 hover:bg-gold-500 hover:text-navy-900 text-sm font-semibold rounded-lg transition-colors whitespace-nowrap"
          aria-label={`Call ${BRAND.name} at ${BRAND.phone}`}
        >
          <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {BRAND.phone}
        </a>
        <a
          href="/contact"
          class="hidden sm:inline-flex items-center px-4 py-2 bg-gold-500 hover:bg-gold-600 text-navy-900 text-sm font-semibold rounded-lg transition-colors"
        >
          Book a Coverage Check
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-toggle"
          class="lg:hidden p-2 text-navy-100 hover:text-white rounded"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-navy-800">
    <div class="max-w-7xl mx-auto px-4 py-3 space-y-1">
      {navLinks.map((link) => (
        link.children ? (
          <div>
            <div class="px-3 py-2 text-xs font-semibold text-gold-400 uppercase tracking-wider">{link.label}</div>
            {link.children.map((child) => (
              <a
                href={child.href}
                class="block px-6 py-2 text-sm text-navy-100 hover:text-white hover:bg-navy-800 rounded transition-colors"
              >
                {child.label}
              </a>
            ))}
          </div>
        ) : (
          <a
            href={link.href}
            class={`block px-3 py-2 text-sm font-medium rounded transition-colors ${
              currentPath === link.href
                ? 'text-gold-400 bg-navy-800'
                : 'text-navy-100 hover:text-white hover:bg-navy-800'
            }`}
          >
            {link.label}
          </a>
        )
      ))}
      <div class="pt-3 pb-1 border-t border-navy-800">
        <a
          href="/contact"
          class="block w-full text-center px-4 py-3 bg-gold-500 hover:bg-gold-600 text-navy-900 text-sm font-semibold rounded-lg transition-colors"
        >
          Book a Coverage Check
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
