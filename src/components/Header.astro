---
import { BRAND } from '../consts';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  {
    label: 'Services',
    href: '/services',
    children: [
      { label: 'Home & Auto', href: '/services/home-auto' },
      { label: 'Small Business', href: '/services/small-business' },
      { label: 'Life Insurance', href: '/services/life-insurance' },
      { label: 'Retirement Income', href: '/services/retirement-income' },
      { label: 'Long-Term Care', href: '/services/long-term-care' },
      { label: 'Medicare', href: '/services/medicare' },
    ],
  },
  { label: 'Our Process', href: '/process' },
  { label: 'Ask the Advisors', href: '/ask' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;

// The homepage hero already forks into "I Need Coverage Now" and "I Want a
// Full Review", so the header's "Book a Coverage Check" is a third competing
// button that duplicates the second. Interior pages have no hero fork, so it
// carries the primary action there and stays. The phone number is unaffected
// and shows everywhere.
const isHome = currentPath === '/' || currentPath === '' || currentPath === '/index.html';
---

<header class="bg-navy-900 text-white sticky top-0 z-50 shadow-lg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-3 lg:gap-5 h-16 md:h-20">

      <!-- Logo / Brand -->
      <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="Hearthside Insurance, home">
        <!-- Shield is decorative: the name sits beside it as real text, so a
             screen reader must not hear it twice.
             The plate is load-bearing, not styling. The artwork is navy on a
             ground that is only 0.8% fully transparent — 53% of its pixels sit
             at alpha 6-59 — so on bg-navy-900 the tree and shield outline
             vanish and the residual alpha reads as a haze rectangle. Verified
             by compositing the PNG over #002443. It is cream rather than white
             so it reads as part of the brand rather than a sticker; drop it
             only when a reversed (light-on-dark) mark exists. -->
        <span class="inline-flex shrink-0 items-center justify-center rounded-xl bg-green-50 p-1">
          <img
            src="/hearthside_mark_transparent.png"
            alt=""
            width="225"
            height="256"
            class="h-9 md:h-10 w-auto"
            loading="eager"
            decoding="async"
          />
        </span>
        <!-- Cinzel is a wide face; kept modest so the nav has room. Drops below
             sm, where the mark alone carries the brand. -->
        <span class="hidden sm:inline font-display font-semibold text-white text-base tracking-tight whitespace-nowrap">
          Hearthside Insurance
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden xl:flex min-w-0 items-center gap-1" aria-label="Main navigation">
        {navLinks.map((link) => (
          link.children ? (
            <div class="relative group">
              <button
                class="flex items-center gap-1 px-2 py-2 text-sm font-medium whitespace-nowrap text-navy-100 hover:text-white hover:bg-navy-800 rounded transition-colors"
                aria-expanded="false"
                aria-haspopup="true"
              >
                {link.label}
                <svg class="w-4 h-4 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute top-full left-0 mt-1 w-52 bg-white rounded-lg shadow-xl border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                {link.children.map((child) => (
                  <a
                    href={child.href}
                    class="block px-4 py-3 text-sm text-gray-700 hover:bg-navy-50 hover:text-navy-900 first:rounded-t-lg last:rounded-b-lg transition-colors"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class={`px-2 py-2 text-sm font-medium whitespace-nowrap rounded transition-colors ${
                currentPath === link.href
                  ? 'text-green-400 bg-navy-800'
                  : 'text-navy-100 hover:text-white hover:bg-navy-800'
              }`}
            >
              {link.label}
            </a>
          )
        ))}
      </nav>

      <!-- Tap-to-call + CTA + Mobile Toggle -->
      <div class="flex shrink-0 items-center gap-3">
        <!-- Always visible, including mobile — never collapses into the hamburger -->
        <a
          href={`tel:${BRAND.phoneE164}`}
          class="inline-flex items-center gap-2 px-3 py-2 border border-green-500 text-green-400 hover:bg-green-50 hover:text-navy-900 text-sm font-semibold rounded-lg transition-colors whitespace-nowrap"
          aria-label={`Call ${BRAND.name} at ${BRAND.phone}`}
        >
          <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {BRAND.phone}
        </a>
        {!isHome && (
          <a
            href="/contact"
            class="hidden sm:inline-flex items-center px-4 py-2 bg-green-50 hover:bg-white text-navy-900 text-sm font-semibold rounded-lg transition-colors"
          >
            Book a Coverage Check
          </a>
        )}

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-toggle"
          class="xl:hidden p-2 text-navy-100 hover:text-white rounded"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="xl:hidden hidden border-t border-navy-800">
    <div class="max-w-7xl mx-auto px-4 py-3 space-y-1">
      {navLinks.map((link) => (
        link.children ? (
          <div>
            <div class="px-3 py-2 text-xs font-semibold text-green-400 uppercase tracking-wider">{link.label}</div>
            {link.children.map((child) => (
              <a
                href={child.href}
                class="block px-6 py-2 text-sm text-navy-100 hover:text-white hover:bg-navy-800 rounded transition-colors"
              >
                {child.label}
              </a>
            ))}
          </div>
        ) : (
          <a
            href={link.href}
            class={`block px-3 py-2 text-sm font-medium rounded transition-colors ${
              currentPath === link.href
                ? 'text-green-400 bg-navy-800'
                : 'text-navy-100 hover:text-white hover:bg-navy-800'
            }`}
          >
            {link.label}
          </a>
        )
      ))}
      {!isHome && (
        <div class="pt-3 pb-1 border-t border-navy-800">
          <a
            href="/contact"
            class="block w-full text-center px-4 py-3 bg-green-50 hover:bg-white text-navy-900 text-sm font-semibold rounded-lg transition-colors"
          >
            Book a Coverage Check
          </a>
        </div>
      )}
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
