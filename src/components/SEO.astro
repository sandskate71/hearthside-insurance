---
import { BRAND } from '../consts';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Emits `noindex,follow` — keeps the page out of the index while internal
      links still pass. Reversible: drop the prop and the page indexes again. */
  noindexFollow?: boolean;
  breadcrumbTitle?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.png',
  noindex = false,
  noindexFollow = false,
  breadcrumbTitle,
} = Astro.props;

const siteUrl = BRAND.url;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'InsuranceAgency',
  '@id': siteUrl,
  name: BRAND.name,
  legalName: BRAND.legalName,
  description: 'Independent insurance advisor serving the Nashville metro area — home, auto, life, Medicare, and long-term care.',
  url: siteUrl,
  telephone: BRAND.phoneE164,
  email: BRAND.email,
  founder: {
    '@type': 'Person',
    name: 'Enrique Gandara',
    jobTitle: 'Independent Insurance Advisor',
  },
  image: `${siteUrl}/og-default.png`,
  // Hearthside shield mark, raster PNG (731x833). Google requires >=112x112
  // for the Organization logo. Swap this for an SVG once the vector exists.
  logo: `${siteUrl}/hearthside_mark_transparent.png`,
  priceRange: '$$',
  areaServed: [
    { '@type': 'City', name: 'Nashville', containedInPlace: { '@type': 'State', name: 'Tennessee' } },
    { '@type': 'City', name: 'Brentwood', containedInPlace: { '@type': 'State', name: 'Tennessee' } },
    { '@type': 'City', name: 'Franklin', containedInPlace: { '@type': 'State', name: 'Tennessee' } },
    { '@type': 'City', name: 'Nolensville', containedInPlace: { '@type': 'State', name: 'Tennessee' } },
    { '@type': 'City', name: 'Hendersonville', containedInPlace: { '@type': 'State', name: 'Tennessee' } },
    { '@type': 'City', name: 'Green Hills', containedInPlace: { '@type': 'State', name: 'Tennessee' } },
    { '@type': 'City', name: 'Bellevue', containedInPlace: { '@type': 'State', name: 'Tennessee' } },
    { '@type': 'City', name: 'Mount Juliet', containedInPlace: { '@type': 'State', name: 'Tennessee' } },
    { '@type': 'City', name: 'Spring Hill', containedInPlace: { '@type': 'State', name: 'Tennessee' } },
    { '@type': 'City', name: 'Murfreesboro', containedInPlace: { '@type': 'State', name: 'Tennessee' } },
    { '@type': 'City', name: 'Hermitage', containedInPlace: { '@type': 'State', name: 'Tennessee' } },
  ],
  serviceType: [
    'Property & Casualty Insurance',
    'Life Insurance',
    'Retirement Income Planning',
    'Long-Term Care Insurance',
    'Medicare Planning',
    'Small Business Insurance',
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    description: 'By appointment only',
  },
  sameAs: [],
};

const segmentNames: Record<string, string> = {
  'about': 'About',
  'services': 'Services',
  'home-auto': 'Home & Auto Insurance',
  'small-business': 'Small Business Insurance',
  'life-insurance': 'Life Insurance',
  'retirement-income': 'Retirement Income Planning',
  'long-term-care': 'Long-Term Care Insurance',
  'medicare': 'Medicare Planning',
  'process': 'Our Process',
  'contact': 'Contact',
  'neighborhoods': 'Areas We Serve',
  'blog': 'Blog',
  'ask': 'Ask the Advisors',
};

const pathname = Astro.url.pathname.replace(/\/$/, '');
const segments = pathname.split('/').filter(Boolean);

const items: { name: string; url: string }[] = [{ name: 'Home', url: siteUrl }];
let currentPath = '';
for (let i = 0; i < segments.length; i++) {
  currentPath += '/' + segments[i];
  const isLast = i === segments.length - 1;
  const name = isLast && breadcrumbTitle
    ? breadcrumbTitle
    : (segmentNames[segments[i]] ?? segments[i]);
  items.push({ name, url: `${siteUrl}${currentPath}` });
}
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.url,
  })),
};
---

<!-- Primary Meta -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && noindexFollow && <meta name="robots" content="noindex,follow" />}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={BRAND.name} />
<meta property="og:locale" content="en_US" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Schema.org LocalBusiness -->
<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

<!-- Schema.org BreadcrumbList -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
