---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  breadcrumbTitle?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.png',
  noindex = false,
  breadcrumbTitle,
} = Astro.props;

const siteUrl = 'https://nashvilleinsuranceadvisors.com';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': siteUrl,
  name: 'Nashville Insurance Advisors, LLC',
  description: 'Independent insurance advisor serving the Nashville metro area — home, auto, life, Medicare, and long-term care.',
  url: siteUrl,
  telephone: '+16153269899',
  email: 'team@nashvilleia.com',
  founder: {
    '@type': 'Person',
    name: 'Enrique Gandara',
    jobTitle: 'Independent Insurance Advisor',
  },
  image: `${siteUrl}/og-default.png`,
  logo: `${siteUrl}/images/logo-dark.svg`,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Nashville Metro Area',
    addressLocality: 'Nashville',
    addressRegion: 'TN',
    postalCode: '37201',
    addressCountry: 'US',
  },
  areaServed: {
    '@type': 'GeoCircle',
    geoMidpoint: {
      '@type': 'GeoCoordinates',
      latitude: 36.1627,
      longitude: -86.7816,
    },
    geoRadius: '80000',
  },
  serviceType: [
    'Property & Casualty Insurance',
    'Life Insurance',
    'Retirement Income Planning',
    'Long-Term Care Insurance',
    'Medicare Planning',
    'Small Business Insurance',
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    description: 'By appointment only',
  },
  sameAs: ['https://nashvilleia.com'],
};

const segmentNames: Record<string, string> = {
  'about': 'About',
  'services': 'Services',
  'home-auto': 'Home & Auto Insurance',
  'small-business': 'Small Business Insurance',
  'life-insurance': 'Life Insurance',
  'retirement-income': 'Retirement Income Planning',
  'long-term-care': 'Long-Term Care Insurance',
  'medicare': 'Medicare Planning',
  'process': 'Our Process',
  'contact': 'Contact',
  'neighborhoods': 'Areas We Serve',
  'blog': 'Blog',
  'faq': 'FAQ',
};

const pathname = Astro.url.pathname.replace(/\/$/, '');
const segments = pathname.split('/').filter(Boolean);

let breadcrumbSchema = null;
if (segments.length > 0) {
  const items: { name: string; url: string }[] = [{ name: 'Home', url: siteUrl }];
  let currentPath = '';
  for (let i = 0; i < segments.length; i++) {
    currentPath += '/' + segments[i];
    const isLast = i === segments.length - 1;
    const name = isLast && breadcrumbTitle
      ? breadcrumbTitle
      : (segmentNames[segments[i]] ?? segments[i]);
    items.push({ name, url: `${siteUrl}${currentPath}` });
  }
  breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: item.url,
    })),
  };
}
---

<!-- Primary Meta -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Nashville Insurance Advisors" />
<meta property="og:locale" content="en_US" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Schema.org LocalBusiness -->
<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

<!-- Schema.org BreadcrumbList -->
{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
