---
import { BRAND } from '../consts';

const currentYear = new Date().getFullYear();

const serviceLinks = [
  { label: 'Home & Auto Insurance', href: '/services/home-auto' },
  { label: 'Small Business Insurance', href: '/services/small-business' },
  { label: 'Life Insurance', href: '/services/life-insurance' },
  { label: 'Retirement Income Planning', href: '/services/retirement-income' },
  { label: 'Long-Term Care', href: '/services/long-term-care' },
  { label: 'Medicare Planning', href: '/services/medicare' },
];

const quickLinks = [
  { label: 'About Your Advisor', href: '/about' },
  { label: 'Our Process', href: '/process' },
  { label: 'Blog', href: '/blog' },
  { label: 'Ask the Advisors', href: '/ask' },
  { label: 'Areas We Serve', href: '/neighborhoods/' },
  { label: 'Business Stories', href: '/nashville-business-stories/' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="bg-navy-950 text-navy-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">

      <!-- Brand Column -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-3 mb-4">
          <!-- Mark removed with the rebrand. Reinstate once the
               Hearthside mark exists. -->
          <span>
            <span class="text-lg font-serif font-semibold text-gold-50">{BRAND.name}</span>
            <span class="block text-xs text-gold-400 tracking-widest uppercase">LLC</span>
          </span>
        </a>
        <p class="text-sm text-navy-300 leading-relaxed mb-4">
          Independent insurance advisory for Nashville metro residents and small businesses — by appointment only.
        </p>
        <address class="not-italic space-y-2 text-sm">
          <a href={`tel:${BRAND.phoneE164}`} class="flex items-center gap-2 text-navy-200 hover:text-gold-400 transition-colors">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {BRAND.phone}
          </a>
          <a href={`mailto:${BRAND.email}`} class="flex items-center gap-2 text-navy-200 hover:text-gold-400 transition-colors">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {BRAND.email}
          </a>
          <p class="flex items-start gap-2 text-navy-300 text-xs">
            <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>
              {BRAND.legalName}
            </span>
          </p>
        </address>
      </div>

      <!-- Services Column -->
      <div>
        <h3 class="text-sm font-semibold text-gold-400 uppercase tracking-wider mb-4">Services</h3>
        <ul class="space-y-2">
          {serviceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-navy-200 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Quick Links Column -->
      <div>
        <h3 class="text-sm font-semibold text-gold-400 uppercase tracking-wider mb-4">Company</h3>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-navy-200 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- CTA Column -->
      <div>
        <h3 class="text-sm font-semibold text-gold-400 uppercase tracking-wider mb-4">Ready to Start?</h3>
        <p class="text-sm text-navy-300 mb-4 leading-relaxed">
          A coverage review starts with a conversation — no pressure, no sales pitch.
        </p>
        <a
          href="/contact"
          class="inline-block w-full text-center px-4 py-3 bg-gold-500 hover:bg-gold-600 text-navy-900 text-sm font-semibold rounded-lg transition-colors"
        >
          Start Your Coverage Roadmap
        </a>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-navy-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-navy-400">
      <p>&copy; {currentYear} {BRAND.legalName}. All rights reserved.</p>
      <div class="flex items-center gap-4 flex-wrap justify-center">
        <a href="/privacy-policy" class="hover:text-navy-200 transition-colors">Privacy Policy</a>
        <span aria-hidden="true">·</span>
        <p>Licensed in Tennessee — Property &amp; Casualty</p>
      </div>
    </div>
  </div>
</footer>
