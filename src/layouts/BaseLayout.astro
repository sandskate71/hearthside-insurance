---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  noindexFollow?: boolean;
  breadcrumbTitle?: string;
}

const { title, description, canonical, ogImage, noindex, noindexFollow, breadcrumbTitle } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Analytics.
         `is:inline` is load-bearing: without it Astro bundles this as a module
         and minifies `gtag` to a local name, so the function never reaches
         `window` and `typeof gtag === 'function'` is false everywhere else on
         the page. page_view still worked because dataLayer is global, which is
         what made the breakage invisible. Any gtag call outside this block —
         including the tel: handler below — depends on this staying inline. -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-F1H924T1E7"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-F1H924T1E7');
    </script>

    <!-- Hearthside brand icons. Raster set; swap for SVG when the vector lands. -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon_16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon_32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon_48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon_96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon_192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon_512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon_180x180.png" />

    <!-- Google Fonts: preconnect + async load (eliminates render blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap"
      />
    </noscript>

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
      noindexFollow={noindexFollow}
      breadcrumbTitle={breadcrumbTitle}
    />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- GA4 phone_click / text_click. One delegated listener for the whole
         site: the number sits in the header, the footer, the contact page and
         the urgent CTA, and delegation means a tel: or sms: link added anywhere
         later is covered for free. Never preventDefault and never await the
         beacon — a dropped hit is acceptable, a delayed dial is not. -->
    <script is:inline>
      document.addEventListener('click', (e) => {
        // e.target is not always an Element (text nodes, the document itself),
        // and this listener must never be the thing that throws on a page.
        const target = e.target;
        if (!target || typeof target.closest !== 'function') return;

        const link = target.closest('a[href^="tel:"], a[href^="sms:"]');
        if (!link) return;

        // Read the scheme off the resolved href rather than re-testing the
        // attribute, so a link is never counted as both.
        const href = link.getAttribute('href') || '';
        const event = href.startsWith('sms:') ? 'text_click' : 'phone_click';

        // Landmarks first: most taps are header or footer, and neither carries
        // a section id, so nearest-id alone would report almost everything as
        // 'unknown' and waste the dimension.
        let location = 'unknown';
        if (link.closest('header')) location = 'header';
        else if (link.closest('footer')) location = 'footer';
        else {
          const section = link.closest('[id]');
          if (section && section.id) location = section.id;
        }

        if (typeof gtag === 'function') gtag('event', event, { link_location: location });
      });
    </script>
  </body>
</html>
