---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  author?: string;
  category?: string;
  ogImage?: string;
}

const {
  title,
  description,
  publishDate,
  author = 'Enrique Gandara',
  category,
  ogImage,
} = Astro.props;

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  datePublished: publishDate.toISOString(),
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Nashville Insurance Advisors, LLC',
    url: 'https://nashvilleinsuranceadvisors.com',
  },
};
---

<BaseLayout title={`${title} | Nashville Insurance Advisors`} description={description} ogImage={ogImage}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-16">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-navy-900 transition-colors">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-navy-900 transition-colors">Blog</a>
      {category && (
        <>
          <span>/</span>
          <span class="text-gray-400">{category}</span>
        </>
      )}
    </nav>

    <!-- Header -->
    <header class="mb-10">
      {category && (
        <span class="inline-block px-3 py-1 bg-gold-100 text-gold-700 text-xs font-semibold uppercase tracking-wider rounded-full mb-4">
          {category}
        </span>
      )}
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-navy-900 leading-tight mb-4">{title}</h1>
      <p class="text-lg text-gray-600 leading-relaxed mb-6">{description}</p>
      <div class="flex items-center gap-3 text-sm text-gray-500">
        <span>By {author}</span>
        <span>·</span>
        <time datetime={publishDate.toISOString()}>{formattedDate}</time>
      </div>
    </header>

    <!-- Content -->
    <div class="prose prose-lg prose-headings:font-serif prose-headings:text-navy-900 prose-a:text-gold-600 prose-a:no-underline hover:prose-a:underline max-w-none">
      <slot />
    </div>

    <!-- CTA -->
    <aside class="mt-14 p-8 bg-navy-900 rounded-2xl text-white text-center">
      <h2 class="text-xl font-serif font-semibold mb-3">Have questions about your coverage?</h2>
      <p class="text-navy-200 mb-6 text-sm">A coverage review is the best way to know where you stand. No sales pitch — just clarity.</p>
      <a
        href="/contact"
        class="inline-block px-6 py-3 bg-gold-500 hover:bg-gold-600 text-navy-900 font-semibold rounded-lg transition-colors"
      >
        Book a Discovery Meeting
      </a>
    </aside>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</BaseLayout>
