---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BRAND } from '../../consts';

export async function getStaticPaths() {
  const stories = await getCollection('businessStories', ({ id }) => id !== 'placeholder');
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const { businessName, tagline, description, funFacts, websiteUrl, youtubeVideoId, pubDate } = story.data;
---

<BaseLayout
  title={`${businessName} | Nashville Business Stories`}
  description={description}
>

  <!-- Hero -->
  <section class="bg-navy-900 text-white py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-navy-300 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/nashville-business-stories" class="hover:text-white transition-colors">Nashville Business Stories</a>
        <span>/</span>
        <span class="text-gold-400">{businessName}</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-serif font-bold mb-3">{businessName}</h1>
      <p class="text-gold-400 text-lg font-medium">{tagline}</p>
    </div>
  </section>

  <!-- YouTube Embed -->
  <section class="bg-navy-950">
    <div class="max-w-4xl mx-auto">
      <div class="relative w-full" style="padding-bottom: 56.25%;">
        <iframe
          class="absolute inset-0 w-full h-full"
          src={`https://www.youtube.com/embed/${youtubeVideoId}`}
          title={`${businessName} — Nashville Business Stories`}
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Story Content -->
  <section class="py-14 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Prose story -->
      <div class="prose prose-lg prose-navy max-w-none mb-12
        prose-headings:font-serif prose-headings:text-navy-900
        prose-p:text-gray-700 prose-p:leading-relaxed
        prose-a:text-gold-600 prose-a:no-underline hover:prose-a:underline">
        <Content />
      </div>

      <!-- Fun Facts -->
      {funFacts.length > 0 && (
        <div class="rounded-2xl bg-navy-50 border border-navy-100 p-8 mb-12">
          <h2 class="text-xl font-serif font-bold text-navy-900 mb-5">Quick Facts</h2>
          <ul class="space-y-3">
            {funFacts.map((fact) => (
              <li class="flex items-start gap-3">
                <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-gold-400 flex items-center justify-center">
                  <svg class="w-3 h-3 text-navy-900" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span class="text-navy-800 text-sm leading-relaxed">{fact}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Website Link -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-8 border-t border-gray-100">
        <div>
          <p class="text-sm text-gray-500 mb-1">Learn more about {businessName}</p>
          <a
            href={websiteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-gold-600 font-semibold hover:text-gold-700 transition-colors"
          >
            Visit their website
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
        <time datetime={pubDate.toISOString()} class="text-xs text-gray-400">
          {pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </time>
      </div>
    </div>
  </section>

  <!-- Footer credit -->
  <div class="bg-navy-900 py-8 text-center">
    <p class="text-sm text-navy-300 max-w-xl mx-auto">
      Nashville Business Stories is brought to you by{' '}
      <a href="/" class="text-gold-400 hover:text-gold-300 transition-colors font-medium">{BRAND.name}</a>
      {' '}— independent insurance advisors serving Middle Tennessee.
    </p>
  </div>

</BaseLayout>
