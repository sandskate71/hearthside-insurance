---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const categories = [
  'Home & Auto',
  'Small Business',
  'Life Insurance',
  'Long-Term Care',
  'Medicare',
  'Insurance Basics',
  'Nashville',
  'General',
];
---

<BaseLayout
  title="Nashville Insurance Advisor Blog | Insights & Guides"
  description="Insurance guidance for Nashville homeowners, small business owners, and families approaching Medicare and retirement — from an independent insurance advisor."
>

  <!-- Page Hero -->
  <section class="bg-navy-900 text-white py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-navy-300 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-gold-400">Blog</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">Nashville Insurance Advisor Blog</h1>
      <p class="text-navy-200 text-lg max-w-2xl">
        Practical coverage guidance for Nashville homeowners, small businesses, and families planning for retirement — from an independent advisor who works for you.
      </p>
    </div>
  </section>

  <!-- Category Filter (static for now) -->
  <section class="bg-white border-b border-gray-100 py-5 sticky top-20 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex gap-2 overflow-x-auto pb-1 scrollbar-hide">
        <span class="flex-shrink-0 px-4 py-2 rounded-full bg-navy-900 text-white text-sm font-medium">All</span>
        {categories.map((cat) => (
          <span class="flex-shrink-0 px-4 py-2 rounded-full border border-gray-200 text-gray-600 text-sm hover:border-navy-400 hover:text-navy-900 cursor-pointer transition-colors">
            {cat}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog Posts -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {posts.length === 0 ? (
        <!-- Empty state — will fill with real posts in next session -->
        <div class="max-w-2xl mx-auto">
          <div class="text-center py-16">
            <p class="text-4xl mb-4">📝</p>
            <h2 class="text-2xl font-serif font-bold text-navy-900 mb-3">Content Coming Soon</h2>
            <p class="text-gray-600 leading-relaxed mb-8">
              We're preparing in-depth insurance guides for Nashville homeowners, small business owners, and families approaching Medicare and retirement. Check back soon — or subscribe to be notified.
            </p>
            <a
              href="/contact"
              class="inline-flex items-center justify-center px-6 py-3 bg-navy-900 hover:bg-navy-800 text-white font-semibold rounded-lg transition-colors"
            >
              Book a Discovery Meeting
            </a>
          </div>

          <!-- Preview topic cards -->
          <div class="mt-12">
            <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-6 text-center">Topics we'll be covering</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {[
                { title: 'What a Comprehensive Insurance Review Actually Looks Like', cat: 'Insurance Basics' },
                { title: 'Home & Auto Insurance Gaps Nashville Residents Don\'t Know They Have', cat: 'Home & Auto' },
                { title: 'Medicare at 65: What to Do 6 Months Before Your Birthday', cat: 'Medicare' },
                { title: 'Long-Term Care Insurance: Who Needs It and When to Buy', cat: 'Long-Term Care' },
                { title: 'Life Insurance Review: When Your Policy No Longer Fits Your Life', cat: 'Life Insurance' },
                { title: 'Small Business Insurance Basics for Nashville Entrepreneurs', cat: 'Small Business' },
              ].map((topic) => (
                <div class="p-5 rounded-xl border border-gray-100 bg-gray-50">
                  <span class="inline-block px-2.5 py-1 bg-gold-100 text-gold-700 text-xs font-semibold rounded-full mb-3">
                    {topic.cat}
                  </span>
                  <p class="text-sm font-medium text-navy-900 leading-snug">{topic.title}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`} class="group rounded-2xl border border-gray-100 hover:border-gold-300 hover:shadow-lg transition-all overflow-hidden bg-white">
              <div class="p-6">
                <span class="inline-block px-3 py-1 bg-gold-100 text-gold-700 text-xs font-semibold rounded-full mb-4">
                  {post.data.category}
                </span>
                <h2 class="text-lg font-serif font-bold text-navy-900 mb-3 leading-snug group-hover:text-gold-700 transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-sm text-gray-600 leading-relaxed mb-4">{post.data.description}</p>
                <div class="flex items-center justify-between text-xs text-gray-400">
                  <span>{post.data.author}</span>
                  <time datetime={post.data.publishDate.toISOString()}>
                    {post.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </time>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-navy-900 text-white text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-serif font-bold mb-3">Questions about your coverage?</h2>
      <p class="text-navy-200 mb-6">Don't wait for an article — schedule a conversation directly.</p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-6 py-3 bg-gold-500 hover:bg-gold-600 text-navy-900 font-semibold rounded-lg transition-colors"
      >
        Book a Discovery Meeting
      </a>
    </div>
  </section>

</BaseLayout>
