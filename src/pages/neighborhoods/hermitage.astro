---
import NeighborhoodPage from '../../components/NeighborhoodPage.astro';
import { BRAND } from '../../consts';
---

<NeighborhoodPage
  neighborhood="Hermitage"
  description="Independent insurance advisor serving Hermitage Nashville TN — home, auto, life insurance, and coverage reviews for Hermitage families in east Nashville."
  intro={`Hermitage is an affordable, established east Nashville community that's increasingly attractive to first-time homebuyers, young families, and professionals who want a shorter commute without the price tags of trendier neighborhoods. Many homeowners here bought when prices were lower and haven't revisited their coverage as values have climbed — a quiet underinsurance problem that shows up clearly in a Coverage Blueprint review. ${BRAND.name} serves Hermitage families who want a straight look at where they actually stand.`}
  gaps={[
    "Home insurance dwelling limits set at the original purchase price that no longer reflect rising east Nashville area property values",
    "Life insurance conversations that haven't happened yet for young families who recently bought their first home",
    "No umbrella coverage despite growing assets and the kind of everyday liability exposure every homeowner carries",
  ]}
/>
