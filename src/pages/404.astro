---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND } from '../consts';

const links = [
  { label: 'Start at the beginning', href: '/', text: 'The home page, and a short explanation of how we work.' },
  { label: 'Our process', href: '/process', text: 'The Coverage Roadmap — how we get you covered, then review the whole picture.' },
  { label: 'Get in touch', href: '/contact', text: 'Book a Coverage Check or send a message.' },
];
---

<BaseLayout
  title={`Page Not Found | ${BRAND.name}`}
  description="That page doesn't exist. Here's where to go instead."
  noindex={true}
>

  <section class="bg-navy-900 text-white py-15">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-green-400 text-sm font-semibold uppercase tracking-widest mb-4">Error 404</p>
        <h1 class="text-4xl md:text-5xl font-display font-bold leading-tight mb-6 text-green-50">
          That page isn't here.
        </h1>
        <p class="text-lg text-navy-200 leading-relaxed">
          Either the address has a typo in it, or we moved something and didn't leave a
          forwarding note. Both happen. Here's where you were probably headed.
        </p>
      </div>
    </div>
  </section>

  <section class="py-15 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl space-y-4">
        {links.map((link) => (
          <a
            href={link.href}
            class="group block p-6 bg-white rounded-2xl border border-gray-100 hover:border-green-300 hover:shadow-lg transition-all duration-200"
          >
            <h2 class="text-lg font-display font-bold text-navy-900 mb-1">{link.label}</h2>
            <p class="text-gray-600 text-sm leading-relaxed mb-3">{link.text}</p>
            <span class="text-green-600 text-sm font-semibold inline-flex items-center gap-1">
              Go there
              <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>

      <div class="max-w-2xl mt-10 pt-8 border-t border-gray-100">
        <p class="text-gray-700 leading-relaxed">
          If you'd rather just ask someone, call
          <a href={`tel:${BRAND.phoneE164}`} class="font-semibold text-navy-900 hover:text-green-600 transition-colors">{BRAND.phone}</a>.
          You'll reach an advisor, not a phone tree.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>
