---
import BaseLayout from '../layouts/BaseLayout.astro';

const stages = [
  {
    number: '01',
    title: 'Stage 1 — The Discovery Meeting',
    description: 'We learn your situation. You learn how we work.',
    detail: 'This is a conversation — no documents required, no products discussed, no pressure. We talk through where you are, what you have, what\'s on your mind, and what you\'re trying to protect. At the end of the meeting we give you a Coverage Checklist — a simple list of everything to gather before our next meeting. You upload your documents to your secure client portal and we take it from there.',
  },
  {
    number: '02',
    title: 'Stage 2 — The Blueprint Meeting',
    description: 'We present the full picture. You decide if you want to move forward.',
    detail: 'Between Stage 1 and Stage 2 we do the homework. We review every document you\'ve uploaded, map your full coverage across every line, and identify every gap — what it is, what it would cost if triggered, and what needs to change. We walk you through the complete analysis in plain English. No jargon, no sales pitch. Then we present our recommendations. If you decide to become a client, we write your P&C coverage — home, auto, umbrella — right there. You leave the meeting already protected.',
  },
  {
    number: '03',
    title: 'Stage 3 — Implementation Meetings',
    description: 'We work through the deeper lines at a pace that makes sense.',
    detail: 'Once you\'re a client, we start working through the lines that take more time and more conversation — Medicare, long-term care, life insurance, retirement income planning. Each line gets its own focused meeting. We don\'t rush these decisions. A life insurance recommendation or a retirement income strategy deserves a dedicated conversation, not a line item on a checklist. We move at your pace, in the order that makes sense for your situation.',
  },
];

const outcomes = [
  {
    title: 'A complete coverage map',
    desc: 'A plain-English summary of everything you have, what it covers, and what it doesn\'t. Not a stack of policy documents — an actual explanation.',
  },
  {
    title: 'A gap analysis',
    desc: 'Every gap identified, quantified, and prioritized. You\'ll know exactly where you\'re exposed and what it would cost if something went wrong today.',
  },
  {
    title: 'A clear recommendation',
    desc: 'Specific, honest recommendations for what to change, add, or leave alone — with the reasoning behind each one. No pressure to act on any of it.',
  },
  {
    title: 'A plan you understand',
    desc: 'A clear next step and the confidence that your coverage actually matches your life. Not a binder full of paperwork — a plan you can explain to your spouse.',
  },
];

const faqs = [
  {
    q: 'How long does the Coverage Blueprint take?',
    a: 'The Discovery Meeting runs about an hour. The Blueprint Meeting typically runs 60 to 90 minutes. Implementation meetings are shorter and more focused. Most clients complete the full three-stage process within two to four weeks.',
  },
  {
    q: 'Is there any cost for the initial review?',
    a: 'No. The Discovery Meeting and Blueprint Meeting are complimentary. We\'re compensated by the carriers when coverage is placed — only if you decide to move forward, and only on what you choose to change. If your coverage is solid and nothing needs to change, we\'ll tell you that.',
  },
  {
    q: 'Do I need to bring anything to our first meeting?',
    a: 'Nothing for the Discovery Meeting — just show up ready to talk. After that meeting we\'ll give you a Coverage Checklist with exactly what to gather. You upload everything to your secure client portal and we review it before the Blueprint Meeting.',
  },
  {
    q: "What if I'm happy with my current coverage?",
    a: "That's a legitimate outcome. If we review everything and your coverage is solid, we'll tell you. Not every Coverage Blueprint results in changes. The goal is clarity — if you already have it, that's worth knowing too.",
  },
];
---

<BaseLayout
  title="Nashville Coverage Blueprint Process | Insurance Advisor"
  description="Nashville Insurance Advisors uses a deliberate, three-stage Coverage Blueprint process — giving you a complete picture of your coverage and a clear plan to fix it."
>

  <!-- Page Hero -->
  <section class="bg-navy-900 text-white py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-navy-300 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-gold-400">Our Process</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">The Coverage Blueprint</h1>
      <p class="text-navy-200 text-lg max-w-2xl">
        A deliberate, three-stage process that gives you a complete picture of your coverage — and a clear plan for what needs to change.
      </p>
    </div>
  </section>

  <!-- Process Intro -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-serif font-bold text-navy-900 mb-5">
        Why We Do It This Way
      </h2>
      <p class="text-gray-600 text-lg leading-relaxed">
        Most insurance conversations start with a quote. Ours start with questions. A quote tells you what something costs. It doesn't tell you whether it's right for your life. The Coverage Blueprint is our answer to that problem — a structured process that examines your full coverage picture before any recommendations are made. Every client goes through the same three stages, in the same order. No shortcuts.
      </p>
    </div>
  </section>

  <!-- Stages -->
  <section class="py-16 pb-24" style="background-color: #f0f4fa;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-8">
        {stages.map((stage, i) => (
          <div class="flex gap-6 md:gap-10 items-start">
            <div class="flex-shrink-0 flex flex-col items-center">
              <div class="w-14 h-14 rounded-full bg-navy-900 text-white flex items-center justify-center font-serif font-bold text-lg">
                {stage.number}
              </div>
              {i < stages.length - 1 && (
                <div class="w-px h-12 bg-navy-200 mt-3"></div>
              )}
            </div>

            <div class="flex-1 pb-2">
              <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
                <h3 class="text-xl md:text-2xl font-serif font-bold text-navy-900 mb-3">{stage.title}</h3>
                <p class="text-gray-700 font-medium mb-4">{stage.description}</p>
                <p class="text-gray-500 text-sm leading-relaxed">{stage.detail}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Annual Life Review -->
  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-serif font-bold text-navy-900 mb-5">
        The Annual Life Review
      </h2>
      <p class="text-gray-600 text-lg leading-relaxed">
        Every October — before Medicare open enrollment and before year end — every client sits down for their Annual Life Review. We go back through your full coverage picture: what's changed in your life, what's changed with your carriers, what's changed in the market. We make adjustments where needed and confirm what's still working. Same advisor, every time. This isn't a courtesy call — it's a structured review that keeps your coverage current with your life.
      </p>
    </div>
  </section>

  <!-- What You Leave With -->
  <section class="py-20" style="background-color: #f0f4fa;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h2 class="text-3xl font-serif font-bold text-navy-900 mb-4">What You Leave With</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {outcomes.map((outcome) => (
          <div class="p-6 rounded-xl bg-navy-900 text-white text-center">
            <div class="w-10 h-10 rounded-full bg-gold-500 flex items-center justify-center mx-auto mb-4">
              <svg class="w-5 h-5 text-navy-900" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h4 class="font-serif font-semibold mb-2">{outcome.title}</h4>
            <p class="text-navy-300 text-sm">{outcome.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-bold text-navy-900 mb-10 text-center">Common Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-100">
            <h3 class="font-serif font-semibold text-navy-900 mb-2">{faq.q}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-navy-900 text-white text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-bold mb-4">Ready to start your Coverage Blueprint?</h2>
      <p class="text-navy-200 text-lg mb-8 max-w-xl mx-auto">
        Schedule a time that works for you. By appointment only in the Nashville metro area.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-8 py-4 bg-gold-500 hover:bg-gold-600 text-navy-900 font-semibold text-lg rounded-lg transition-colors"
      >
        Schedule Your Discovery Meeting
      </a>
    </div>
  </section>

</BaseLayout>
