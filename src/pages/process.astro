---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND } from '../consts';

const stages = [
  {
    number: '01',
    title: 'Stage 1 — The Coverage Check',
    description: 'Fifteen minutes. Bring your current declarations pages.',
    detail: "A short, practical conversation. You bring what you're paying for now — the declarations pages from your home and auto policies — and we look at them together. Nothing is sold in this meeting and there is nothing to sign. By the end you'll know whether what you have is holding up, and what it would take to fix it if it isn't. No obligation either way.",
  },
  {
    number: '02',
    title: 'Stage 2 — Quote & Bind',
    description: 'Get covered.',
    detail: "If you need coverage in place, we place it. We go through the options, explain what each one actually does and where it stops, and put the policy in force. You don't have to sit through a full review to get protected — that's backwards when you have a closing date on the calendar or a policy about to lapse. Coverage first. The deeper work comes next.",
  },
  {
    number: '03',
    title: 'Stage 3 — The Coverage Roadmap Review',
    description: "Thirty to forty-five days after you're covered. Included. Nothing to buy.",
    detail: "Once you're protected, we do the real work. We map your full coverage picture across every line — home, auto, umbrella, life, long-term care, Medicare, retirement income planning — and identify every gap: what it is, what it would cost you if it triggered, and what needs to change. We walk you through all of it in plain English. This is part of being a client, not an upsell. There is nothing to buy at the end of it, and plenty of Roadmaps end with “you're in good shape.”",
  },
  {
    number: '04',
    title: 'Stage 4 — The Annual Life Review',
    description: 'Every year, in the month you came aboard.',
    detail: "Once a year, on the anniversary of the month you first came on board, we go back through your full coverage picture: what's changed in your life, what's changed with your carriers, what's changed in the market. We make adjustments where they're needed and confirm what's still working. Same advisor, every time. This isn't a courtesy call — it's a structured review that keeps your coverage current with your life.",
  },
];

const entryPoints = [
  {
    label: 'Fast Track',
    tag: 'Most people start here',
    desc: "You have a deadline — a closing date, a renewal, a policy about to lapse, a lender asking for proof. We run the Coverage Check, get you covered, and do the Roadmap once you can breathe again.",
  },
  {
    label: 'Roadmap First',
    tag: 'Usually a referral',
    desc: "No urgency, and you'd rather see the whole picture before anything moves. We do the full review first, then place coverage with everything already on the table.",
  },
];

const outcomes = [
  {
    title: 'A complete coverage map',
    desc: "A plain-English summary of everything you have, what it covers, and what it doesn't. Not a stack of policy documents — an actual explanation.",
  },
  {
    title: 'A gap analysis',
    desc: "Every gap identified, quantified, and prioritized. You'll know exactly where you're exposed and what it would cost if something went wrong today.",
  },
  {
    title: 'A clear recommendation',
    desc: 'Specific, honest recommendations for what to change, add, or leave alone — with the reasoning behind each one. No pressure to act on any of it.',
  },
  {
    title: 'A plan you understand',
    desc: 'A clear next step and the confidence that your coverage actually matches your life. Not a binder full of paperwork — a plan you can explain to your spouse.',
  },
];

const faqs = [
  {
    q: 'How long does the whole process take?',
    a: "The Coverage Check runs about fifteen minutes. Placing coverage happens as soon as we have what we need from you. The Coverage Roadmap Review runs 60 to 90 minutes and usually lands 30 to 45 days after you're covered. After that, the Annual Life Review comes around once a year.",
  },
  {
    q: 'Is there any cost for the review?',
    a: "No. The Coverage Check and the Coverage Roadmap Review are both included. We're compensated by the carriers when coverage is placed, and only on what you choose to put in force. If your coverage is already solid, we'll tell you that.",
  },
  {
    q: 'Do I need to bring anything to the Coverage Check?',
    a: "Your current declarations pages — the summary pages from your home and auto policies. That's it. Before the Coverage Roadmap Review we'll send a short checklist and you upload everything to your secure client portal.",
  },
  {
    q: 'Do I have to do the Roadmap?',
    a: "No. Some people come to us for one policy and that's all they want. That's a fine place to stop. The Roadmap is included if you want it, and most clients take it once they've seen how we work.",
  },
];
---

<BaseLayout
  title="The Coverage Roadmap | Nashville Insurance Process"
  description={`${BRAND.name} uses a four-stage Coverage Roadmap — get covered when you need it, then a full review of your coverage picture across every line.`}
>

  <!-- Page Hero -->
  <section class="bg-navy-900 text-white py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-navy-300 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-gold-400">Our Process</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">The Coverage Roadmap</h1>
      <p class="text-navy-200 text-lg max-w-2xl">
        Get covered when you need it. Then get the whole picture. Four stages, two ways in — both end in the same place.
      </p>
    </div>
  </section>

  <!-- Process Intro -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-serif font-bold text-navy-900 mb-5">
        Why We Do It This Way
      </h2>
      <p class="text-gray-600 text-lg leading-relaxed">
        Most insurance conversations start and end with a quote. A quote tells you what something costs. It doesn't tell you whether it's right for your life. But making someone sit through a full review before they're allowed to get covered is backwards too — especially when there's a closing date on the calendar. So we do both, in whichever order fits your situation. Coverage when you need it. The full picture either way.
      </p>
    </div>
  </section>

  <!-- Stages -->
  <section class="py-16 pb-24" style="background-color: #f0f4fa;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-8">
        {stages.map((stage, i) => (
          <div class="flex gap-6 md:gap-10 items-start">
            <div class="flex-shrink-0 flex flex-col items-center">
              <div class="w-14 h-14 rounded-full bg-navy-900 text-white flex items-center justify-center font-serif font-bold text-lg">
                {stage.number}
              </div>
              {i < stages.length - 1 && (
                <div class="w-px h-12 bg-navy-200 mt-3"></div>
              )}
            </div>

            <div class="flex-1 pb-2">
              <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
                <h3 class="text-xl md:text-2xl font-serif font-bold text-navy-900 mb-3">{stage.title}</h3>
                <p class="text-gray-700 font-medium mb-4">{stage.description}</p>
                <p class="text-gray-500 text-sm leading-relaxed">{stage.detail}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Two Ways In -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h2 class="text-3xl font-serif font-bold text-navy-900 mb-4">Two Ways In, Same Destination</h2>
        <p class="text-gray-600 leading-relaxed">
          Where you start depends on whether the clock is running. Everyone ends up in the same place.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {entryPoints.map((entry) => (
          <div class="p-8 rounded-2xl border border-gray-100 shadow-sm" style="background-color: #f0f4fa;">
            <span class="inline-block text-xs font-semibold uppercase tracking-wide text-gold-700 mb-3">{entry.tag}</span>
            <h3 class="text-xl font-serif font-bold text-navy-900 mb-3">{entry.label}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{entry.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What You Leave With -->
  <section class="py-20" style="background-color: #f0f4fa;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h2 class="text-3xl font-serif font-bold text-navy-900 mb-4">What You Leave With</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {outcomes.map((outcome) => (
          <div class="p-6 rounded-xl bg-navy-900 text-white text-center">
            <div class="w-10 h-10 rounded-full bg-gold-500 flex items-center justify-center mx-auto mb-4">
              <svg class="w-5 h-5 text-navy-900" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h4 class="font-serif font-semibold mb-2">{outcome.title}</h4>
            <p class="text-navy-300 text-sm">{outcome.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-bold text-navy-900 mb-10 text-center">Common Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-gray-50 rounded-xl p-6 border border-gray-100">
            <h3 class="font-serif font-semibold text-navy-900 mb-2">{faq.q}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-navy-900 text-white text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-bold mb-4">Ready to get started?</h2>
      <p class="text-navy-200 text-lg mb-8 max-w-xl mx-auto">
        Schedule a time that works for you. By appointment only in the Nashville metro area.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-8 py-4 bg-gold-500 hover:bg-gold-600 text-navy-900 font-semibold text-lg rounded-lg transition-colors"
      >
        Schedule Your Coverage Check
      </a>
    </div>
  </section>

</BaseLayout>
