---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Long-Term Care Planning Nashville | Nashville Insurance Advisors"
  description="Long-term care insurance planning for Nashville residents — understand your options before you need care. Independent advice from Enrique Gandara at Nashville Insurance Advisors."
>

  <!-- Page Hero -->
  <section class="bg-navy-900 text-white py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-navy-300 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/services" class="hover:text-white transition-colors">Services</a>
        <span>/</span>
        <span class="text-gold-400">Long-Term Care</span>
      </nav>
      <span class="text-4xl block mb-4">🤝</span>
      <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">Long-Term Care Planning</h1>
      <p class="text-navy-200 text-lg max-w-2xl">
        [Placeholder tagline — one sentence about planning for long-term care costs before a health event forces the decision.]
      </p>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

        <!-- Primary Content -->
        <div class="lg:col-span-2">
          <h2 class="text-2xl md:text-3xl font-serif font-bold text-navy-900 mb-6">
            [Placeholder: Why Long-Term Care Planning Can't Wait]
          </h2>
          <div class="space-y-5 text-gray-600 leading-relaxed">
            <p>[Paragraph 1 placeholder — statistics on LTC costs and what they can do to a retirement plan.]</p>
            <p>[Paragraph 2 placeholder — the window for getting coverage (age and health considerations).]</p>
            <p>[Paragraph 3 placeholder — how LTC planning fits into a broader retirement and estate strategy.]</p>
          </div>

          <!-- Options Comparison -->
          <div class="mt-12">
            <h3 class="text-xl font-serif font-bold text-navy-900 mb-6">Long-Term Care Solutions We Review</h3>
            <div class="space-y-4">
              {[
                {
                  name: 'Traditional LTC Insurance',
                  desc: 'Placeholder — standalone long-term care policy. Use-it-or-lose-it structure. Best for specific situations.',
                },
                {
                  name: 'Hybrid Life / LTC',
                  desc: 'Placeholder — life insurance policy with LTC rider. Benefit whether you use the care or not.',
                },
                {
                  name: 'Annuity with LTC Rider',
                  desc: 'Placeholder — annuity-based LTC funding strategy. Useful for asset repositioning.',
                },
                {
                  name: 'Self-Insurance Analysis',
                  desc: 'Placeholder — for high-net-worth clients, analyzing whether self-insuring makes sense.',
                },
              ].map((option) => (
                <div class="p-6 rounded-xl border border-gray-200 bg-gray-50">
                  <h4 class="font-serif font-semibold text-navy-900 mb-2">{option.name}</h4>
                  <p class="text-sm text-gray-600">{option.desc}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Stat callout placeholder -->
          <div class="mt-12 p-8 rounded-2xl border-l-4 border-gold-500 bg-gold-50" style="background-color: #fdf8ee;">
            <p class="text-xl font-serif font-semibold text-navy-900 mb-2">
              "[Placeholder statistic about long-term care costs or probability of needing care]"
            </p>
            <p class="text-sm text-gray-500">[Source placeholder]</p>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="sticky top-24 space-y-6">
            <div class="p-6 rounded-2xl bg-navy-900 text-white">
              <h3 class="font-serif font-semibold text-lg mb-3">Start Your LTC Planning</h3>
              <p class="text-navy-200 text-sm mb-5">
                The best time to plan is before you need it. Schedule a conversation.
              </p>
              <a
                href="/contact"
                class="block w-full text-center px-4 py-3 bg-gold-500 hover:bg-gold-600 text-navy-900 font-semibold rounded-lg transition-colors text-sm"
              >
                Schedule Your Coverage Review
              </a>
              <a
                href="tel:+16153269899"
                class="block w-full text-center px-4 py-3 mt-3 border border-navy-600 hover:border-navy-400 text-white font-medium rounded-lg transition-colors text-sm"
              >
                Call (615) 326-9899
              </a>
            </div>

            <div class="p-6 rounded-xl border border-gray-200 bg-gray-50">
              <h4 class="font-serif font-semibold text-navy-900 mb-3">Related Services</h4>
              <ul class="space-y-2">
                <li><a href="/services/life-annuities" class="text-sm text-gold-600 hover:text-gold-700 transition-colors">Life Insurance & Annuities →</a></li>
                <li><a href="/services/medicare" class="text-sm text-gold-600 hover:text-gold-700 transition-colors">Medicare Planning →</a></li>
                <li><a href="/services/home-auto" class="text-sm text-gold-600 hover:text-gold-700 transition-colors">Home & Auto Insurance →</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
