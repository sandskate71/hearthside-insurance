---
import BaseLayout from '../../layouts/BaseLayout.astro';

const services = [
  {
    title: 'Home & Auto Insurance',
    slug: 'home-auto',
    icon: '🏠',
    tagline: 'Personal lines coverage review',
    description: "Your home, your cars, your stuff — reviewed together so the gaps between policies don't catch you off guard.",
    keywords: ['homeowners insurance Nashville', 'auto insurance Nashville', 'personal umbrella policy'],
  },
  {
    title: 'Small Business Insurance',
    slug: 'small-business',
    icon: '🏢',
    tagline: 'Commercial coverage for Nashville businesses',
    description: "Commercial coverage for Nashville business owners who can't afford to find out what's missing the hard way.",
    keywords: ['small business insurance Nashville', 'commercial insurance Nashville', 'business liability'],
  },
  {
    title: 'Life Insurance',
    slug: 'life-insurance',
    icon: '🛡️',
    tagline: 'Income protection for Nashville families',
    description: "The right life insurance for where you are now — we review what you have, whether it still fits, and what needs to change.",
    keywords: ['life insurance Nashville', 'term life insurance Nashville', 'whole life insurance Nashville'],
  },
  {
    title: 'Retirement Income Planning',
    slug: 'retirement-income',
    icon: '📈',
    tagline: 'Guaranteed income strategies for retirement',
    description: "Turn your savings into predictable retirement income — guaranteed strategies for Nashville families who want to stop guessing about what retirement pays.",
    keywords: ['retirement income planning Nashville', 'guaranteed income Nashville', 'retirement planning Tennessee'],
  },
  {
    title: 'Long-Term Care',
    slug: 'long-term-care',
    icon: '🤝',
    tagline: 'Plan before you need it',
    description: "Plan for long-term care before a health event forces the decision. The window for good options closes faster than most people think.",
    keywords: ['long-term care insurance Nashville', 'LTC planning Tennessee'],
  },
  {
    title: 'Medicare Planning',
    slug: 'medicare',
    icon: '⚕️',
    tagline: 'Medicare plan selection and annual review',
    description: "Independent Medicare guidance for Nashville residents turning 65 or reviewing their current plan during open enrollment.",
    keywords: ['Medicare advisor Nashville', 'Medicare supplement Nashville', 'Medicare Advantage Nashville'],
  },
];
---

<BaseLayout
  title="Insurance Services Nashville | Independent Advisor"
  description="Independent insurance reviews across home, auto, small business, life, long-term care, and Medicare — serving Nashville and the surrounding metro area by appointment."
>

  <!-- Page Hero -->
  <section class="bg-navy-900 text-white py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-navy-300 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-gold-400">Services</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">Coverage We Review</h1>
      <p class="text-navy-200 text-lg max-w-2xl">
        Every client gets the same deliberate process — a comprehensive review across every line of coverage, in plain English, with no pressure to change anything.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {services.map((service) => (
          <a
            href={`/services/${service.slug}`}
            class="group p-8 rounded-2xl border border-gray-100 hover:border-gold-300 hover:shadow-lg transition-all duration-200 bg-white"
          >
            <div class="flex items-start gap-5">
              <span class="text-4xl flex-shrink-0">{service.icon}</span>
              <div class="flex-1">
                <p class="text-gold-600 text-xs font-semibold uppercase tracking-wider mb-1">{service.tagline}</p>
                <h2 class="text-xl font-serif font-bold text-navy-900 mb-3 group-hover:text-gold-700 transition-colors">
                  {service.title}
                </h2>
                <p class="text-gray-600 text-sm leading-relaxed mb-4">{service.description}</p>
                <span class="text-gold-600 text-sm font-semibold inline-flex items-center gap-1">
                  Learn more
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-20 bg-navy-900 text-white text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-bold mb-4">Not sure where to start?</h2>
      <p class="text-navy-200 text-lg mb-8 max-w-xl mx-auto">
        A comprehensive coverage review looks at everything together — not just one line at a time.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-8 py-4 bg-gold-500 hover:bg-gold-600 text-navy-900 font-semibold text-lg rounded-lg transition-colors"
      >
        Book a Coverage Check
      </a>
    </div>
  </section>

</BaseLayout>
