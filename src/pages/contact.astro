---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallCta from '../components/CallCta.astro';
import { BRAND } from '../consts';

// The contact form is dormant while form delivery is down. To bring it back
// when EZLynx intake is live (~2026-09-15): uncomment the import below and
// swap <CallCta ... /> for <ContactForm /> in the markup. One line each way.
// import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Schedule Coverage Review Nashville | Insurance Advisor"
  description={`Schedule your comprehensive insurance coverage review with ${BRAND.name}. By appointment only, serving the Nashville metro area. Call today.`}
>

  <!-- Page Hero -->
  <section class="bg-navy-900 text-white py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-navy-300 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-green-400">Contact</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-display font-bold mb-4">Schedule Your Coverage Review</h1>
      <p class="text-navy-200 text-lg max-w-2xl">
        By appointment only — serving the Nashville metro area. No walk-ins, no call center. Just a real conversation with your advisor.
      </p>
    </div>
  </section>

  <!-- Contact Content -->
  <section id="contact-details" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14">

        <!-- Contact Info -->
        <div>
          <h2 class="text-2xl font-display font-bold text-navy-900 mb-8">Get in Touch</h2>

          <div class="space-y-6 mb-10">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-navy-100 flex items-center justify-center">
                <svg class="w-5 h-5 text-navy-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Phone</p>
                <a href={`tel:${BRAND.phoneE164}`} class="text-lg font-medium text-navy-900 hover:text-green-600 transition-colors">
                  {BRAND.phone}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-navy-100 flex items-center justify-center">
                <svg class="w-5 h-5 text-navy-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Email</p>
                <a href={`mailto:${BRAND.email}`} class="text-lg font-medium text-navy-900 hover:text-green-600 transition-colors">
                  {BRAND.email}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-navy-100 flex items-center justify-center">
                <svg class="w-5 h-5 text-navy-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Service Area</p>
                <p class="text-lg font-medium text-navy-900">Nashville Metro Area</p>
                <p class="text-sm text-gray-500 mt-0.5">By appointment only · We come to you</p>
              </div>
            </div>
          </div>

          <!-- What to Expect -->
          <div class="p-6 rounded-xl border border-gray-200 bg-gray-50">
            <h3 class="font-display font-semibold text-navy-900 mb-4">What to expect from your first call</h3>
            <ul class="space-y-2 text-sm text-gray-600">
              <li class="flex items-start gap-2">
                <span class="text-green-500 mt-0.5">◆</span>
                A genuine conversation — not a sales pitch. We'll ask about your situation and you can ask us anything.
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-500 mt-0.5">◆</span>
                No pressure to buy anything. The first call is about figuring out if we're a good fit for each other.
              </li>
              <li class="flex items-start gap-2">
                <span class="text-green-500 mt-0.5">◆</span>
                A clear next step. You'll leave knowing exactly what the Coverage Roadmap process looks like and what comes next.
              </li>
            </ul>
          </div>
        </div>

        <!-- Form delivery is down (no Resend key, no verified sending domain),
             so calling is the action. See src/components/ContactForm.astro to
             restore the form when EZLynx intake lands (~2026-09-15). -->
        <div>
          <CallCta
            id="call-cta"
            eyebrow="Talk to an advisor"
            heading="Give us a call"
            body="You'll reach a real advisor — no phone tree, no call centre. Tell us what you have and we'll tell you where you stand. Most first calls take about fifteen minutes."
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
