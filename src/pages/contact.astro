---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Schedule a Coverage Review | Nashville Insurance Advisors"
  description="Schedule your comprehensive insurance coverage review with Nashville Insurance Advisors. By appointment only, serving the Nashville metro area."
>

  <!-- Page Hero -->
  <section class="bg-navy-900 text-white py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-navy-300 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-gold-400">Contact</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">Schedule Your Coverage Review</h1>
      <p class="text-navy-200 text-lg max-w-2xl">
        By appointment only — serving the Nashville metro area. No walk-ins, no call center. Just a real conversation with your advisor.
      </p>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14">

        <!-- Contact Info -->
        <div>
          <h2 class="text-2xl font-serif font-bold text-navy-900 mb-8">Get in Touch</h2>

          <div class="space-y-6 mb-10">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-navy-100 flex items-center justify-center">
                <svg class="w-5 h-5 text-navy-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Phone</p>
                <a href="tel:+16153269899" class="text-lg font-medium text-navy-900 hover:text-gold-600 transition-colors">
                  (615) 326-9899
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-navy-100 flex items-center justify-center">
                <svg class="w-5 h-5 text-navy-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Email</p>
                <a href="mailto:team@nashvilleia.com" class="text-lg font-medium text-navy-900 hover:text-gold-600 transition-colors">
                  team@nashvilleia.com
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-navy-100 flex items-center justify-center">
                <svg class="w-5 h-5 text-navy-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Service Area</p>
                <p class="text-lg font-medium text-navy-900">Nashville Metro Area</p>
                <p class="text-sm text-gray-500 mt-0.5">By appointment only · No physical office</p>
              </div>
            </div>
          </div>

          <!-- What to Expect -->
          <div class="p-6 rounded-xl border border-gray-200 bg-gray-50">
            <h3 class="font-serif font-semibold text-navy-900 mb-4">What to expect from your first call</h3>
            <ul class="space-y-2 text-sm text-gray-600">
              <li class="flex items-start gap-2">
                <span class="text-gold-500 mt-0.5">◆</span>
                A genuine conversation — not a sales pitch. We'll ask about your situation and you can ask us anything.
              </li>
              <li class="flex items-start gap-2">
                <span class="text-gold-500 mt-0.5">◆</span>
                No pressure to buy anything. The first call is about figuring out if we're a good fit for each other.
              </li>
              <li class="flex items-start gap-2">
                <span class="text-gold-500 mt-0.5">◆</span>
                A clear next step. You'll leave knowing exactly what the Coverage Blueprint process looks like and what comes next.
              </li>
            </ul>
          </div>
        </div>

        <!-- Contact Form / Scheduler -->
        <div>
          <div class="p-8 rounded-2xl border border-gray-200 bg-white shadow-sm">
            <h2 class="text-2xl font-serif font-bold text-navy-900 mb-2">Send a Message</h2>
            <p class="text-gray-500 text-sm mb-8">
              Have a question or ready to get started? Fill out the form below and we'll get back to you within one business day. No spam, no pressure — just a real response from a real advisor.
            </p>

            <!-- Form placeholder — will wire up to Netlify Forms or similar -->
            <form class="space-y-5" name="contact" method="POST">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="first-name" class="block text-sm font-medium text-gray-700 mb-1.5">First name</label>
                  <input
                    type="text"
                    id="first-name"
                    name="first-name"
                    autocomplete="given-name"
                    class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-navy-500 focus:border-transparent text-gray-900 text-sm"
                    placeholder="Jane"
                  />
                </div>
                <div>
                  <label for="last-name" class="block text-sm font-medium text-gray-700 mb-1.5">Last name</label>
                  <input
                    type="text"
                    id="last-name"
                    name="last-name"
                    autocomplete="family-name"
                    class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-navy-500 focus:border-transparent text-gray-900 text-sm"
                    placeholder="Smith"
                  />
                </div>
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-1.5">Email address</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  autocomplete="email"
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-navy-500 focus:border-transparent text-gray-900 text-sm"
                  placeholder="jane@example.com"
                />
              </div>

              <div>
                <label for="phone" class="block text-sm font-medium text-gray-700 mb-1.5">Phone number</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  autocomplete="tel"
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-navy-500 focus:border-transparent text-gray-900 text-sm"
                  placeholder="(615) 000-0000"
                />
              </div>

              <div>
                <label for="interest" class="block text-sm font-medium text-gray-700 mb-1.5">What can we help with?</label>
                <select
                  id="interest"
                  name="interest"
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-navy-500 focus:border-transparent text-gray-900 text-sm bg-white"
                >
                  <option value="">Select a topic...</option>
                  <option value="home-auto">Home & Auto Insurance</option>
                  <option value="small-business">Small Business Insurance</option>
                  <option value="life-annuities">Life Insurance & Annuities</option>
                  <option value="long-term-care">Long-Term Care</option>
                  <option value="medicare">Medicare Planning</option>
                  <option value="comprehensive-review">Comprehensive Coverage Review</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-gray-700 mb-1.5">Message (optional)</label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-navy-500 focus:border-transparent text-gray-900 text-sm resize-none"
                  placeholder="Tell us a bit about your situation..."
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full px-6 py-4 bg-navy-900 hover:bg-navy-800 text-white font-semibold rounded-lg transition-colors text-sm"
              >
                Send Message
              </button>

              <p class="text-xs text-gray-400 text-center">
                We'll respond within one business day. No spam, no pressure.
              </p>
            </form>
          </div>

          <!-- Scheduling -->
          <div class="mt-6 p-6 rounded-xl border border-gold-200 bg-gold-50" style="background-color: #fdf8ee; border-color: #e5a848;">
            <p class="text-sm font-semibold text-navy-900 mb-1">Prefer to book directly?</p>
            <p class="text-sm text-gray-600">
              Call us at <a href="tel:+16153269899" class="font-medium text-navy-900 hover:text-gold-600 transition-colors">(615) 326-9899</a> or email <a href="mailto:team@nashvilleia.com" class="font-medium text-navy-900 hover:text-gold-600 transition-colors">team@nashvilleia.com</a> — we'll find a time that works.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
