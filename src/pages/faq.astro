---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    label: 'Life Insurance',
    id: 'life-insurance',
    questions: [
      {
        q: 'How much life insurance do I actually need?',
        a: "You need enough to cover all outstanding debts and give your family a real safety net — not just survival money, but enough time to breathe, grieve, and figure out next steps without scrambling. The goal isn't a precise formula. It's making sure the people who depend on you aren't left in a financial emergency on top of everything else.",
      },
      {
        q: 'Term vs. permanent — which one is right for me?',
        a: 'Term is great early on when budget is tight — it gives you solid, affordable protection for a defined period. Permanent insurance is built for long-term planning because it never expires as long as it stays in force. No renewal surprises, no aging out of coverage. As your life evolves, your coverage should too. Most people need term first and revisit permanent later.',
      },
      {
        q: 'Can I still get life insurance if I have health issues?',
        a: "More than you'd think. Medical advances have changed underwriting significantly — something like controlled blood pressure barely moves the needle anymore. It's always worth having the conversation even if you're not sure you qualify. The answer might surprise you.",
      },
      {
        q: 'Is the life insurance through my employer enough?',
        a: null, // PLACEHOLDER — fill in before publishing
      },
      {
        q: 'At what age should I stop carrying life insurance?',
        a: null, // PLACEHOLDER — fill in before publishing
      },
    ],
  },
  {
    label: 'Long-Term Care',
    id: 'long-term-care',
    questions: [
      {
        q: 'What does long-term care insurance actually cover?',
        a: "It kicks in when you can no longer perform two of the six activities of daily living — things like bathing, eating, and using the bathroom independently. It covers the cost of having someone help you with those daily needs, whether that's in your home, an assisted living facility, or a nursing home.",
      },
      {
        q: 'Why is traditional long-term care insurance so hard to find now?',
        a: "Many companies that offered it in the 80s and 90s went bankrupt — nobody predicted how long people would live or how much care they'd need. Today we use hybrid products that are more flexible, including home care coverage that traditional policies often excluded or made unaffordable.",
      },
      {
        q: "If I never use it, did I waste my money?",
        a: "No. With modern hybrid structures, unused benefits pass to your beneficiaries. The money doesn't disappear — it either pays for your care or it passes on.",
      },
      {
        q: "What happens if I don't plan for long-term care at all?",
        a: "If you run out of money and don't have family able to care for you, Medicaid becomes the default — and Medicaid facilities are not where anyone wants to spend their final years. Planning ahead keeps those options off the table.",
      },
      {
        q: 'When should I start thinking about long-term care coverage?',
        a: "As early as possible. The younger and healthier you are, the simpler and more affordable it is to structure coverage that actually works. The window is narrower than most people think.",
      },
    ],
  },
  {
    label: 'Retirement Income Planning',
    id: 'retirement-income',
    questions: [
      {
        q: "What's the difference between saving for retirement and planning for retirement?",
        a: "Saving is the action. Planning is how you put that money to work so it lasts. One fills the bucket — the other makes sure the bucket never runs dry.",
      },
      {
        q: "How do I make sure I never run out of money in retirement?",
        a: "When you're younger you can afford market risk. In retirement, peace of mind comes from guaranteed income that covers your actual budget. We build a plan around your real numbers — what you spend, what you need guaranteed, and what can stay invested.",
      },
    ],
  },
  {
    label: 'Working With an Independent Advisor',
    id: 'working-with-us',
    questions: [
      {
        q: 'What does an independent insurance advisor actually do?',
        a: null, // PLACEHOLDER — fill in before publishing
      },
      {
        q: 'How is a Coverage Blueprint review different from just getting a quote?',
        a: null, // PLACEHOLDER — fill in before publishing
      },
      {
        q: 'How often should I review my insurance?',
        a: null, // PLACEHOLDER — fill in before publishing
      },
      {
        q: "What's the difference between an independent and a captive agent?",
        a: null, // PLACEHOLDER — fill in before publishing
      },
    ],
  },
];
---

<BaseLayout
  title="Insurance FAQs | Nashville Insurance Advisors"
  description="Honest answers to common insurance questions — life insurance, long-term care, retirement income planning, and how the Coverage Blueprint works."
  breadcrumbTitle="FAQ"
>

  <!-- Page Hero -->
  <section class="bg-navy-900 text-white py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-navy-300 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-gold-400">FAQ</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-serif font-bold mb-4">Insurance Questions, Answered Honestly</h1>
      <p class="text-navy-200 text-lg max-w-2xl">
        No jargon. No sales pitch. Just straight answers to the questions we hear most.
      </p>
    </div>
  </section>

  <!-- FAQ Content -->
  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Section jump links -->
      <nav class="flex flex-wrap gap-3 mb-14" aria-label="FAQ sections">
        {sections.map((section) => (
          <a
            href={`#${section.id}`}
            class="px-4 py-2 rounded-full border border-navy-200 text-sm font-medium text-navy-700 hover:border-gold-400 hover:text-navy-900 transition-colors"
          >
            {section.label}
          </a>
        ))}
      </nav>

      <div class="space-y-16">
        {sections.map((section) => (
          <div id={section.id}>
            <div class="mb-8">
              <p class="text-gold-600 text-xs font-semibold uppercase tracking-widest mb-2">
                {section.label}
              </p>
              <h2 class="text-2xl font-serif font-bold text-navy-900">
                {section.label} Questions
              </h2>
            </div>

            <div class="space-y-3">
              {section.questions.map((item) => (
                <details class="group rounded-xl border border-gray-200 bg-gray-50 overflow-hidden">
                  <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none select-none">
                    <span class="font-serif font-semibold text-navy-900 text-base leading-snug">
                      {item.q}
                    </span>
                    <span class="flex-shrink-0 w-6 h-6 rounded-full bg-navy-100 flex items-center justify-center transition-transform duration-200 group-open:rotate-45">
                      <svg class="w-3.5 h-3.5 text-navy-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                      </svg>
                    </span>
                  </summary>

                  <div class="px-6 pb-6">
                    <div class="pt-1 border-t border-gray-200 mt-1">
                      {item.a !== null ? (
                        <p class="text-gray-600 text-sm leading-relaxed pt-4">{item.a}</p>
                      ) : (
                        /* PLACEHOLDER — answer not yet written */
                        <div class="mt-4 px-4 py-3 rounded-lg border border-dashed border-amber-400 bg-amber-50">
                          <p class="text-amber-700 text-sm font-medium italic">
                            [PLACEHOLDER — to be filled in]
                          </p>
                        </div>
                      )}
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-navy-900 text-white text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-serif font-bold mb-4">Still have questions?</h2>
      <p class="text-navy-200 text-lg mb-8 max-w-xl mx-auto">
        The best way to get a straight answer is a real conversation. No pressure, no pitch.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-8 py-4 bg-gold-500 hover:bg-gold-600 text-navy-900 font-semibold text-lg rounded-lg transition-colors"
      >
        Book a Discovery Meeting
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
